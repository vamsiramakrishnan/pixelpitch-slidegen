# Shared by Docker and gcloud builds submit --ignore-file. Allowlisted context.
**
!pyproject.toml
!uv.lock
!README.md
!app/
!app/**
!agy-worker/
!agy-worker/pyproject.toml
!agy-worker/uv.lock
!agy-worker/*.py
!agy-worker/skills/
!agy-worker/skills/**
!mcp-app/
!mcp-app/Dockerfile
!mcp-app/Dockerfile.dockerignore
!mcp-app/cloudbuild.yaml
!mcp-app/package.json
!mcp-app/package-lock.json
!mcp-app/tsconfig.json
!mcp-app/vite.config.ts
!mcp-app/index.html
!mcp-app/host.html
!mcp-app/src/
!mcp-app/src/**

# Apply after directory inclusion, including vendored skill trees.
**/.env*
**/.adk/**
**/.tmp/**
**/.venv/**
**/node_modules/**
**/__pycache__/**
**/*.pyc
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json
