# Pixelpitch slidegen deployment configuration.
#
# Copy to deploy.env and edit, or run `mise run configure` to be asked.
# deploy.env is gitignored; it is per-tenancy, not per-repository.
#
# Only values a human knows belong in this file. The project number, the
# Cloud Run service URLs and the Gemini Enterprise service agent address are
# all derived at deploy time, because a written-down copy of any of them
# goes stale without telling you.

# Required. The Google Cloud project everything is created in.
PROJECT_ID=your-gcp-project-id

# Region for Cloud Run, Artifact Registry and the deck bucket.
REGION=us-central1

# Where Vertex serves the models from. Distinct from REGION, which is where
# the containers run. Leave as global unless you have a data residency rule
# that says otherwise.
MODEL_LOCATION=global

# Bucket for generated decks. Leave blank for <PROJECT_ID>-slidegen-decks.
# Bucket names are a global namespace, so this has to be unique to you.
DECK_BUCKET=

# Artifact Registry repository holding the renderer image.
ARTIFACT_REPO=pixelpitch-agents

# The Gemini Enterprise app the agent is registered into, as a full resource
# name. Leave blank and `mise run register` will let agents-cli prompt you.
# To see the apps in your project first:  mise run ge-apps
# GE_APP_ID=projects/GE_PROJECT_ID/locations/GE_LOCATION/collections/default_collection/engines/GE_APP_ID
GE_APP_ID=
## Customer choices (mise run configure prompts for these).
# a2a | mcp | both
DEPLOYMENT_MODE=a2a
# Optional model ID. Blank preserves the existing .env override or code default.
AUTHORING_MODEL=
# automatic: prepare each uploaded PPTX generation; on-demand: prepare on first use.
TEMPLATE_PREPARATION=automatic
# Existing registration ID within GE_APP_ID; never an OAuth client ID.
GE_AGENT_ID=
# Required for mcp/both. Public ID only; client secret goes in GE connector UI.
MCP_OAUTH_CLIENT_ID=
MCP_ALLOWED_EMAIL_DOMAINS=
