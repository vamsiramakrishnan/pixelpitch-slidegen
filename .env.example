# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Pixelpitch slidegen configuration
SLIDEGEN_RENDERER_URL=http://localhost:8080
SLIDEGEN_GCS_BUCKET=your-pptx-bucket
SLIDEGEN_CONVERSATION_MODEL=gemini-3.7-flash
SLIDEGEN_AUTHORING_MODEL=gemini-3.7-flash
SLIDEGEN_CRITIQUE_MODEL=gemini-3.7-flash
SLIDEGEN_REFERENCE_MODEL=gemini-3.7-flash
SLIDEGEN_SLIDE_CONCURRENCY=4

# The local lifecycle sets SLIDEGEN_A2A_JOB_DB to its port-scoped SQLite path.
# Do not set it on Cloud Run: the workstation queue requires persistent local
# disk and the independent app.a2a_worker process. See docs/a2a-background-jobs.md.
